{
  "version": 2,
  "buildCommand": "prisma generate && nest build",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": [
        "dist/**",
        "node_modules/.prisma/**",
        "node_modules/@prisma/client/**",
        "prisma/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
