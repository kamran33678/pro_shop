datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// -------------------------------------------------------------
// USER & ROLE MANAGEMENT
// -------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  STAFF
  MANAGER
  SALESPERSON
  TECHNICIAN
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  username      String?       @unique
  phone         String?
  passwordHash  String
  role          UserRole      @default(STAFF)
  status        AccountStatus @default(ACTIVE)
  permissions   String[]      @default([]) // Explicit permissions if customized
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sales         Sale[]
  purchases     Purchase[]
  stockMovements StockMovement[]
  expenses      Expense[]
  assignedRepairs RepairJob[]  @relation("TechnicianRepairs")
  activityLogs  ActivityLog[]

  @@map("users")
}

// -------------------------------------------------------------
// PRODUCT & INVENTORY
// -------------------------------------------------------------

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Product {
  id               String          @id @default(uuid())
  name             String
  sku              String          @unique
  barcode          String?         @unique
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  brand            String?
  model            String?
  description      String?
  purchaseCost     Decimal         @default(0.00) @db.Decimal(12, 2)
  sellingPrice     Decimal         @default(0.00) @db.Decimal(12, 2)
  currentStock     Int             @default(0)
  minStockLevel    Int             @default(5)
  imageUrl         String?
  warrantyDetails  String?
  isTrackedByImei  Boolean         @default(false)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  variants         ProductVariant[]
  imeiRecords      ImeiRecord[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  repairParts      RepairPart[]

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  ram             String?
  storage         String?
  color           String?
  additionalCost  Decimal     @default(0.00) @db.Decimal(12, 2)
  additionalPrice Decimal     @default(0.00) @db.Decimal(12, 2)
  sku             String?     @unique
  barcode         String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  imeiRecords     ImeiRecord[]

  @@map("product_variants")
}

enum DeviceStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  IN_REPAIR
}

model ImeiRecord {
  id              String         @id @default(uuid())
  imei            String         @unique
  serialNumber    String?        @unique
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id])
  status          DeviceStatus   @default(AVAILABLE)
  purchaseCost    Decimal        @default(0.00) @db.Decimal(12, 2)
  sellingPrice    Decimal?       @db.Decimal(12, 2)
  purchaseDate    DateTime?
  saleDate        DateTime?
  warrantyExpiry  DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  saleItems       SaleItem[]

  @@index([imei])
  @@index([status])
  @@map("imei_records")
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT
  REPAIR_PART_USAGE
}

model StockMovement {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantity       Int               // positive (increment) or negative (decrement)
  costPerUnit    Decimal           @default(0.00) @db.Decimal(12, 2)
  referenceType  String?           // 'PURCHASE', 'SALE', 'REPAIR', 'ADJUSTMENT'
  referenceId    String?
  reason         String?
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@map("stock_movements")
}

// -------------------------------------------------------------
// SUPPLIERS & PURCHASES
// -------------------------------------------------------------

model Supplier {
  id              String            @id @default(uuid())
  name            String
  phone           String
  email           String?
  address         String?
  companyName     String?
  openingBalance  Decimal           @default(0.00) @db.Decimal(12, 2)
  currentBalance  Decimal           @default(0.00) @db.Decimal(12, 2) // positive means shop owes supplier
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  purchases       Purchase[]
  payments        PurchasePayment[]

  @@map("suppliers")
}

enum PurchaseStatus {
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CARD
  CREDIT
  PARTIAL
}

model Purchase {
  id             String            @id @default(uuid())
  invoiceNumber  String            @unique
  supplierId     String
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  totalAmount    Decimal           @db.Decimal(12, 2)
  discountAmount Decimal           @default(0.00) @db.Decimal(12, 2)
  netAmount      Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0.00) @db.Decimal(12, 2)
  balanceAmount  Decimal           @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod     @default(CASH)
  status         PurchaseStatus    @default(COMPLETED)
  notes          String?
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  items          PurchaseItem[]
  payments       PurchasePayment[]

  @@index([invoiceNumber])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2)
  totalCost   Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@map("purchase_items")
}

model PurchasePayment {
  id               String        @id @default(uuid())
  purchaseId       String?
  purchase         Purchase?     @relation(fields: [purchaseId], references: [id])
  supplierId       String
  supplier         Supplier      @relation(fields: [supplierId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH)
  paymentAccountId String?
  notes            String?
  createdAt        DateTime      @default(now())

  @@map("purchase_payments")
}

// -------------------------------------------------------------
// CUSTOMERS & SALES (POS)
// -------------------------------------------------------------

model Customer {
  id              String        @id @default(uuid())
  name            String
  phone           String        @unique
  email           String?
  address         String?
  openingBalance  Decimal       @default(0.00) @db.Decimal(12, 2)
  currentBalance  Decimal       @default(0.00) @db.Decimal(12, 2) // positive means customer owes shop
  totalPurchases  Decimal       @default(0.00) @db.Decimal(12, 2)
  totalPayments   Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sales           Sale[]
  salePayments    SalePayment[]
  repairJobs      RepairJob[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

enum SaleStatus {
  COMPLETED
  RETURNED
  CANCELLED
}

model Sale {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  customerId     String?
  customer       Customer?     @relation(fields: [customerId], references: [id])
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus    @default(COMPLETED)
  notes          String?
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items          SaleItem[]
  payments       SalePayment[]
  returns        SaleReturn[]

  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id            String      @id @default(uuid())
  saleId        String
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  imeiRecordId  String?
  imeiRecord    ImeiRecord? @relation(fields: [imeiRecordId], references: [id])
  quantity      Int         @default(1)
  unitPrice     Decimal     @db.Decimal(12, 2)
  unitCost      Decimal     @db.Decimal(12, 2)
  totalDiscount Decimal     @default(0.00) @db.Decimal(12, 2)
  totalPrice    Decimal     @db.Decimal(12, 2)
  grossProfit   Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@map("sale_items")
}

model SalePayment {
  id               String        @id @default(uuid())
  saleId           String?
  sale             Sale?         @relation(fields: [saleId], references: [id])
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH)
  paymentAccountId String?
  transactionRef   String?
  createdAt        DateTime      @default(now())

  @@map("sale_payments")
}

model SaleReturn {
  id                 String           @id @default(uuid())
  returnNumber       String           @unique
  saleId             String
  sale               Sale             @relation(fields: [saleId], references: [id])
  totalRefundAmount  Decimal          @db.Decimal(12, 2)
  reason             String?
  createdAt          DateTime         @default(now())

  items              SaleReturnItem[]

  @@map("sale_returns")
}

model SaleReturnItem {
  id             String      @id @default(uuid())
  saleReturnId   String
  saleReturn     SaleReturn  @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  productId      String
  quantity       Int
  refundAmount   Decimal     @db.Decimal(12, 2)
  restockStock   Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@map("sale_return_items")
}

// -------------------------------------------------------------
// MOBILE REPAIRING MANAGEMENT
// -------------------------------------------------------------

enum RepairStatus {
  RECEIVED
  UNDER_INSPECTION
  WAITING_FOR_APPROVAL
  WAITING_FOR_PARTS
  IN_PROGRESS
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model RepairJob {
  id                   String                 @id @default(uuid())
  ticketNumber         String                 @unique
  customerId           String
  customer             Customer               @relation(fields: [customerId], references: [id])
  deviceBrand          String
  deviceModel          String
  imeiOrSerial         String?
  reportedProblem      String
  deviceCondition      String?
  accessoriesReceived  String?
  diagnosis            String?
  estimatedCost        Decimal                @default(0.00) @db.Decimal(12, 2)
  customerApproved     Boolean                @default(false)
  assignedTechnicianId String?
  assignedTechnician   User?                  @relation("TechnicianRepairs", fields: [assignedTechnicianId], references: [id])
  status               RepairStatus           @default(RECEIVED)
  partsCost            Decimal                @default(0.00) @db.Decimal(12, 2)
  labourCharge         Decimal                @default(0.00) @db.Decimal(12, 2)
  finalAmount          Decimal                @default(0.00) @db.Decimal(12, 2)
  paidAmount           Decimal                @default(0.00) @db.Decimal(12, 2)
  balanceAmount        Decimal                @default(0.00) @db.Decimal(12, 2)
  notes                String?
  receivingDate        DateTime               @default(now())
  deliveryDate         DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  partsUsed            RepairPart[]
  statusHistory        RepairStatusHistory[]

  @@index([ticketNumber])
  @@index([status])
  @@map("repair_jobs")
}

model RepairPart {
  id          String    @id @default(uuid())
  repairJobId String
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int       @default(1)
  unitCost    Decimal   @db.Decimal(12, 2)
  unitPrice   Decimal   @db.Decimal(12, 2)
  totalCost   Decimal   @db.Decimal(12, 2)
  totalPrice  Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@map("repair_parts")
}

model RepairStatusHistory {
  id          String        @id @default(uuid())
  repairJobId String
  repairJob   RepairJob     @relation(fields: [repairJobId], references: [id], onDelete: Cascade)
  status      RepairStatus
  notes       String?
  updatedById String?
  createdAt   DateTime      @default(now())

  @@map("repair_status_history")
}

// -------------------------------------------------------------
// DOUBLE-ENTRY ACCOUNTS & EXPENSES
// -------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CASH
  BANK
  MOBILE_WALLET
  RECEIVABLE
  PAYABLE
  INVENTORY
  COGS
  OPERATING_EXPENSE
  SALES_REVENUE
  SERVICE_REVENUE
}

model Account {
  id             String         @id @default(uuid())
  code           String         @unique
  name           String
  type           AccountType
  subType        AccountSubType
  currentBalance Decimal        @default(0.00) @db.Decimal(14, 2)
  isSystem       Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  journalLines   JournalLine[]
  expenses       Expense[]

  @@map("accounts")
}

model JournalEntry {
  id            String        @id @default(uuid())
  entryNumber   String        @unique
  date          DateTime      @default(now())
  referenceType String?       // 'SALE', 'PURCHASE', 'EXPENSE', 'REPAIR', 'PAYMENT'
  referenceId   String?
  description   String
  createdAt     DateTime      @default(now())

  lines         JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0.00) @db.Decimal(14, 2)
  credit         Decimal      @default(0.00) @db.Decimal(14, 2)

  @@map("journal_lines")
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id               String          @id @default(uuid())
  title            String
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount           Decimal         @db.Decimal(12, 2)
  description      String?
  paymentAccountId String
  paymentAccount   Account         @relation(fields: [paymentAccountId], references: [id])
  date             DateTime        @default(now())
  receiptUrl       String?
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  createdAt        DateTime        @default(now())

  @@map("expenses")
}

// -------------------------------------------------------------
// SYSTEM SETTINGS & AUDIT LOGS
// -------------------------------------------------------------

model ShopSetting {
  id                 String   @id @default("default")
  shopName           String   @default("PRO SHOP Mobile & Electronics")
  phone              String   @default("+92 300 0000000")
  email              String   @default("info@proshop.pk")
  address            String   @default("Main Market, Pakistan")
  currency           String   @default("PKR")
  timezone           String   @default("Asia/Karachi")
  receiptHeader      String?  @default("Thank you for choosing PRO SHOP!")
  receiptFooter      String?  @default("Warranty claims require this original invoice. Mobile phones once sold are non-refundable.")
  invoicePrefix      String   @default("INV-")
  repairTicketPrefix String   @default("REP-")
  logoUrl            String?
  updatedAt          DateTime @updatedAt

  @@map("shop_settings")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  recordId    String?
  description String
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([module])
  @@map("activity_logs")
}
